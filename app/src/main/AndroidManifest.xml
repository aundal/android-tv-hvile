<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 10 and later only let the app open its warning over a paused film when it may
         draw over other apps. The install script grants it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Exact inactivity alarms on Android 12+. Without it the alarm may come minutes late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name">

        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The settings: on/off, inactivity minutes, warning on/off and length. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- "Ser du stadig TV?" over whatever is on screen. Nobody answering means sleep at zero. -->
        <activity
            android:name=".StillActivity"
            android:taskAffinity=""
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:theme="@style/Still" />

        <!-- Exported only to callers holding WRITE_SECURE_SETTINGS (the adb shell), for testing. -->
        <receiver
            android:name=".IdleReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- Sees every remote key (never consumed) to reset the inactivity timer, and performs the
             lock-screen global action that puts the TV to sleep. It asks for no events and cannot
             read the screen. -->
        <service
            android:name=".IdleService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/idle_service" />
        </service>
    </application>
</manifest>
